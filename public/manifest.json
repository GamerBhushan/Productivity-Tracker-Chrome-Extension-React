{
    "manifest_version": 3,
    "name": "Productivity Tracker",
    "version": "1.0.0",
    "description": "Productivity Tracker",
    "permissions": [
        "storage",
        "tabs",
        "alarms"
    ],
    "icons": {
        "16": "icons/icon.png",
        "32": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/icon.png",
            "32": "icons/icon.png",
            "48": "icons/icon.png",
            "128": "icons/icon.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}